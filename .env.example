GUESTGUARD_DATA_DIR=data
GUESTGUARD_MODEL_DIR=models
GUESTGUARD_BASE_URL=http://127.0.0.1:8000
GUESTGUARD_SESSION_SECONDS=3600
GUESTGUARD_PIN_SECONDS=300
GUESTGUARD_VOICE_THRESHOLD=0.72
GUESTGUARD_VOICE_MARGIN=0.08
GUESTGUARD_COOKIE_SECURE=false
# Optional OpenAI-compatible tool-selection provider. Requests leave the machine only if configured.
GUESTGUARD_LLM_BASE_URL=https://api.openai.com/v1
GUESTGUARD_LLM_API_KEY=
GUESTGUARD_LLM_MODEL=gpt-4.1-mini
# Local general-question model. No key or cloud account is needed.
GUESTGUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
GUESTGUARD_OLLAMA_MODEL=qwen3:4b-instruct
